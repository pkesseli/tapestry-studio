{
  "name": "tapestry-studio",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @tapestry/app dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck:ts7": "pnpm -r exec node ../../node_modules/typescript7/bin/tsc -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "pnpm --filter @tapestry/app test:e2e",
    "check": "node scripts/check-file-size.mjs && node scripts/check-deps.mjs",
    "verify": "pnpm format:check && pnpm check && pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "tapestry": "tsx packages/cli/src/index.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "typescript7": "npm:typescript@7.0.2",
    "vitest": "^5.0.5"
  }
}
