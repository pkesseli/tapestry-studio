      "text": "INT. HARBOR - NIGHT"
    },
    {
      "type": "action",
      "text": "MARIA lifts a LANTERN and peers into the fog. A distant HORN sounds."
    },
    {
      "type": "character",
      "text": "MARIA"
    },
    {
      "type": "dialogue",
      "text": "Is anyone there?"
    },
    {
